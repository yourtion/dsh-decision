{
  "name": "@techs/dsh-decision",
  "version": "0.2.0",
  "description": "Decision layer for dsh: provider-agnostic typed judgments (Jev first) behind tool guardrail, model routing, result judging, and machine approval seams",
  "keywords": [
    "decision",
    "deepseek-harness",
    "dsh-plugin",
    "guardrail"
  ],
  "homepage": "https://github.com/yourtion/dsh-decision#readme",
  "bugs": "https://github.com/yourtion/dsh-decision/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yourtion/dsh-decision.git",
    "directory": "packages/decision"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.zh-CN.md"
  ],
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./kernel": {
      "types": "./lib/kernel.d.ts",
      "default": "./lib/kernel.js"
    },
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-agent": "0.1.7-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.7-rc.2",
    "@deepseek-ai/dsh-session": "0.1.7-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.7-rc.2",
    "@deepseek-ai/dsh-user-approval": "0.1.7-rc.2",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4"
  },
  "engines": {
    "node": ">=22.19"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
