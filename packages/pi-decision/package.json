{
  "name": "@techs/pi-decision",
  "version": "0.2.1",
  "description": "Tool guardrail for pi with Jev, OpenAI and OpenRouter Decisions providers",
  "keywords": [
    "guardrail",
    "jev",
    "openai",
    "openrouter",
    "pi-extension",
    "pi-package"
  ],
  "homepage": "https://github.com/yourtion/dsh-decision#readme",
  "bugs": "https://github.com/yourtion/dsh-decision/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yourtion/dsh-decision.git",
    "directory": "packages/pi-decision"
  },
  "files": [
    "src",
    "lib",
    "README.zh-CN.md"
  ],
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@techs/dsh-decision": "workspace:~",
    "@techs/dsh-decision-jev": "workspace:~",
    "@techs/dsh-decision-openai": "workspace:~",
    "@techs/dsh-decision-openrouter": "workspace:~"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.87.1",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "engines": {
    "node": ">=22.19"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  }
}
