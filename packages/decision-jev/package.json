{
  "name": "@techs/dsh-decision-jev",
  "version": "0.2.0",
  "description": "Jev (TypeSafe System One) adapter for the dsh decision layer",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "guardrail",
    "jev"
  ],
  "homepage": "https://github.com/yourtion/dsh-decision#readme",
  "bugs": "https://github.com/yourtion/dsh-decision/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yourtion/dsh-decision.git",
    "directory": "packages/decision-jev"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.zh-CN.md"
  ],
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./provider": {
      "types": "./lib/provider.d.ts",
      "default": "./lib/provider.js"
    },
    "./spec": {
      "types": "./lib/spec.d.ts",
      "default": "./lib/spec.js"
    },
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run && node --test eval/eval-core.test.mjs eval/calibrate.test.mjs eval/compare-thresholds.test.mjs eval/diagnostics.test.mjs",
    "eval": "node eval/run-eval.mjs",
    "eval:replay": "node eval/run-eval.mjs --replay",
    "eval:analyze": "node eval/analyze.mjs"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@techs/dsh-decision": "workspace:~",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@techs/dsh-decision": "workspace:~"
  },
  "engines": {
    "node": ">=22.19"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
